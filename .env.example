# --- Database (Supabase Postgres, used via Prisma) --------------------------
# Find these in Supabase: Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- Supabase Auth (used to identify the logged-in user in API routes) -----
# Find these in Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SERVICE ROLE key - also on the API settings page. This bypasses all
# security rules, so keep it server-only and NEVER prefix it with NEXT_PUBLIC_.
# Used to create pre-verified users after our own Resend code check succeeds.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Resend (sends the 6-digit signup verification code) -------------------
# Find your API key at resend.com/api-keys
RESEND_API_KEY="your-resend-api-key"
# Must be an address on a domain you've verified in Resend (resend.com/domains)
RESEND_FROM_EMAIL="5number <noreply@5number.online>"

# --- SMSPVA (the SMS number provider) ---------------------------------------
# Find this in your SMSPVA account dashboard
SMSPVA_API_KEY="your-smspva-api-key"
